# Copy to .env.local and fill in. All values below are placeholders. Never commit .env.local.

# --- Storage (optional) ------------------------------------------------------
# Folder for the invoice database file (invoices.json). Defaults to ./data
# INVOICE_DATA_DIR=./data

# --- Email (SMTP via Brevo) --------------------------------------------------
# Brevo: SMTP & API page -> SMTP tab. The login is shown there; generate an SMTP key and use it as
# the password (not your Brevo account password).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
# Must be a sender you have verified in Brevo (Senders, Domains & Dedicated IPs -> Senders).
EMAIL_FROM="Folio Invoices <your-verified-sender@example.com>"

# Optional safety rail: only these recipients may be emailed (comma-separated addresses or
# @domain entries). Leave it unset to allow any recipient, e.g. so a reviewer can try the
# feature with their own address. Recommended if the app is ever publicly reachable.
# EMAIL_ALLOWED_RECIPIENTS=you@example.com

# Using another SMTP provider? Same variables, different values (untested here).
# Testing with no account: run `npm run smtp-sink`, then use
#   SMTP_HOST=127.0.0.1  SMTP_PORT=1025  EMAIL_FROM=invoices@localhost.test  (no user/password needed)
